+##
+# @AvRecProperties:
+#
+# Properties for avrec objects: a screen and sound recorder
+# (ui/avrec.c) that encodes a console's picture and an audiodev's
+# mix into an MP4 file through an ffmpeg child process.
+#
+# @path: the MP4 file to write
+#
+# @fps: frames per second, sampled on the host clock (default: 30)
+#
+# @scale: integer upscaling with sharp pixels (default: 1)
+#
+# @audiodev: the audiodev whose mix is recorded (default: the
+#     machine's)
+#
+# @console: index of the console to record (default: the first
+#     graphic console)
+#
+# Since: 11.1
+##
+{ 'struct': 'AvRecProperties',
+  'data': { 'path': 'str',
+            '*fps': 'uint32',
+            '*scale': 'uint32',
+            '*audiodev': 'str',
+            '*console': 'uint32' } }
+
 ##
 # @ObjectType:
 #
