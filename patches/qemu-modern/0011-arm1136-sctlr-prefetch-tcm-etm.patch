+/*
+ * qembian 0011 (x-arm1136-tcm-etm): registers of the ARM1136 that QEMU's model lacks, read by the N95 modem
+ * firmware (docs/research/n95-cmt-emulation.md): the Data/Instruction TCM region registers (c9, c1, 0/1;
+ * 0 = no TCM, writes ignored) and the ETM's coprocessor interface (MRC/MCR p14, 1, Rd, c0, CRm, opc2;
+ * read as zero, writes ignored: no trace macrocell behind it), except ETMCR (c0, c0, 0: kept) and ETMSR
+ * (c0, c4, 0: bit 1 "programming" = ETMCR bit 10), which the firmware polls when it programs the ETM.
+ */
+static uint64_t etmcr_read(CPUARMState *env, const ARMCPRegInfo *ri)
+{
+    return env_archcpu(env)->etmcr;
+}
+
+static void etmcr_write(CPUARMState *env, const ARMCPRegInfo *ri, uint64_t value)
+{
+    env_archcpu(env)->etmcr = value;
+}
+
+static uint64_t etmsr_read(CPUARMState *env, const ARMCPRegInfo *ri)
+{
+    return (env_archcpu(env)->etmcr >> 10 & 1) << 1;
+}
+
+static const ARMCPRegInfo arm1136_tcm_etm_reginfo[] = {
+    { .name = "DTCMRR", .cp = 15, .crn = 9, .crm = 1, .opc1 = 0, .opc2 = 0,
+      .access = PL1_RW, .type = ARM_CP_CONST, .resetvalue = 0 },
+    { .name = "ITCMRR", .cp = 15, .crn = 9, .crm = 1, .opc1 = 0, .opc2 = 1,
+      .access = PL1_RW, .type = ARM_CP_CONST, .resetvalue = 0 },
+    { .name = "ETM", .cp = 14, .crn = 0, .crm = CP_ANY, .opc1 = 1, .opc2 = CP_ANY,
+      .access = PL1_RW, .type = ARM_CP_CONST | ARM_CP_OVERRIDE, .resetvalue = 0 },
+    { .name = "ETMCR", .cp = 14, .crn = 0, .crm = 0, .opc1 = 1, .opc2 = 0,
+      .access = PL1_RW, .type = ARM_CP_NO_RAW, .readfn = etmcr_read, .writefn = etmcr_write },
+    { .name = "ETMSR", .cp = 14, .crn = 0, .crm = 4, .opc1 = 1, .opc2 = 0,
+      .access = PL1_RW, .type = ARM_CP_NO_RAW, .readfn = etmsr_read, .writefn = arm_cp_write_ignore },
+};
+
