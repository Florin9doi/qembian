+// The driver is closed and created again when a client forces a media change with
+// KForceMediaChangeReOpenMediaDriver (Belle's file server after formatting C:): give back the
+// interrupt, the DFCs and the transfer buffer, or the new instance cannot bind the interrupt
+DMediaDriverNVMemory::~DMediaDriverNVMemory()
+	{
+	Interrupt::Disable(NVMEM_IRQ);
+	Interrupt::Unbind(NVMEM_IRQ);
+	iSessionEndDfc.Cancel();
+	iTransactionLaunchDfc.Cancel();
+	WriteReg(NVMEM_HWBASE, R_NVMEM_ENABLE, 0);
+	if (iBufChunk)
+		iBufChunk->Close(NULL);
+	if (iTransferBufferPhys)
+		Epoc::FreePhysicalRam(iTransferBufferPhys, KNVMemTransferBufferSize);
+	}
