+// The phone's own C:/E: media sit on a peripheral bus socket (eMMC, NAND controller), so the local
+// media layer lets their clients force a media change that reopens the media driver
+// (KForceMediaChangeReOpenMediaDriver). Belle's file server does that after formatting C: and
+// otherwise remounts the old volume and fails (KErrGeneral, then KErrCorrupt/KErrInUse on every
+// access). The drive attributes (caps) stay non-removable.
+class DNVMemPrimaryMedia : public DPrimaryMediaBase
+	{
+public:
+	virtual TBool IsRemovableDevice(TInt& aSocketNum)
+		{
+		aSocketNum = NVMEM_MEDIADEVICE;
+		return ETrue;
+		}
+	};
