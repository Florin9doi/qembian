     s->row_latch = ~rows;
 }
 
+/* qembian: press/release a key of the MPUIO keypad matrix (board code; QEMU dropped this API) */
+void omap_mpuio_key(struct omap_mpuio_s *s, int row, int col, int down)
+{
+    if (row < 0 || row > 4 || col < 0 || col > 7) {
+        return;
+    }
+    if (down) {
+        s->buttons[row] |= 1 << col;
+    } else {
+        s->buttons[row] &= ~(1 << col);
+    }
+    omap_mpuio_kbd_update(s);
+    qemu_log_mask(LOG_UNIMP, "omap-mpuio: key r%d c%d %s (cols %02x mask %d clk %d latch %02x)\n",
+                  row, col, down ? "down" : "up", s->cols, s->kbd_mask, s->clk, s->row_latch);
+}
