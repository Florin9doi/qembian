+/*
+ * qembian: the transfer-done interrupts and the TX DMA request. SR5 bit 1 enables the interrupts
+ * (the Nokia 9500 sets SR5 = 2 and binds both interrupts) [V guest], bit 0 the DMA request [I]. The
+ * Nokia 9500's EuWire.dll binds "Lv2_uWireTX" / "Lv2_uWireRX" and waits for them: without them
+ * one transfer went out per boot and every Microwire user (the inner panel's ID read, the LM4855
+ * amplifier, the cover LCD) hung. Each completed transfer pulses its line (as levels held until
+ * a CSR/RDR read they stormed: EuWire's handler acknowledges otherwise).
+ */
+static void omap_uwire_done(struct omap_uwire_s *s, bool tx, bool rx)
+{
+    if (s->setup[4] & 2) {
+        if (tx) {
+            qemu_irq_pulse(s->txirq);
+        }
+        if (rx) {
+            qemu_irq_pulse(s->rxirq);
+        }
+    }
+    if ((s->setup[4] & 1) && tx) {
+        qemu_irq_lower(s->txdrq);
+        qemu_irq_raise(s->txdrq);
+    }
+}
