     }
 }
 
+int omap_dma_sync_state(struct soc_dma_s *dma, int sync)
+{
+    struct omap_dma_s *s = dma->opaque;
+    int r = (dma->drqbmp >> sync) & 1 ? 8 : 0;
+
+    for (int i = 0; i < s->chans; i++) {
+        if (s->ch[i].sync == sync) {
+            r |= (s->ch[i].enable ? 1 : 0) | (s->ch[i].active ? 2 : 0) |
+                 (s->ch[i].pending_request ? 4 : 0);
+        }
+    }
+    return r;
+}
