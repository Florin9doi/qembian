// LCD HAL extension for the Nokia E90: two screens (patch qemu-baseport 0028): screen 0 = the inner 800x352 panel
// (the board fb size), screen 1 = the cover 240x320 with its own video RAM; the fb shows the screen switched on
// last. Otherwise as lcd_portrait: 32 bpp EColor16MU, stride = width x 4.
//
#include "../../variant.mmh"
#include "kernel/kern_ext.mmh"
TARGET			VariantTarget(lcd_e90,dll)
TARGETTYPE		kext
MACRO			__PORTRAIT_DISPLAY__
MACRO			SYBORG_FB_REPORTED_BPP=32
MACRO			SYBORG_FB_DISPLAY_MODE=1
MACRO			SYBORG_FB_NUM_MODES=2
MACRO			SYBORG_FB_SCREEN1_W=240
MACRO			SYBORG_FB_SCREEN1_H=320
SYSTEMINCLUDE	AsspNKernIncludePath
SYSTEMINCLUDE	../../fb
SOURCEPATH		../../fb
SOURCE			syborg_fb.cpp
LIBRARY			PlatformLib
EPOCALLOWDLLDATA
UID				0x1000008d 0x100039e8
VENDORID		0x70000001
ROMTARGET		lcd.dll
CAPABILITY		all
