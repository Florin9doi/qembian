// Sony Ericsson P1i HALKE.LDD stand-in (see tablestub.h)
#include "../../variant.mmh"
#include <kernel/kern_ext.mmh>
target			VariantTarget(halke,ldd)
linkas			halke.ldd
targettype		ldd
sourcepath		.
source			halke.cpp
noexportlibrary
vendorid		0x70000001
capability		all
epocallowdlldata		// the attribute values (control 1 sets them)
userinclude		../_shared	// src/standins/_shared: tablestub.h, iscpeer.inl, isireplies.h, stubcert.h
