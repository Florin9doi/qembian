# Hosted EKA2 guest kernel (QEMU aarch64 `virt`): the WHOLE configuration we ask for, on top of `allnoconfig`.
# scripts/build-hosted-kernel.sh builds `make allnoconfig KCONFIG_ALLCONFIG=<this file>` and fails if any line
# here does not end up in the final .config as written. Everything else is either off (allnoconfig) or pulled in
# by a dependency or `select` of what is listed (the build writes the resolved list to
# build/hosted/linux/hosted-resolved.config for review). Each option says what needs it.
# Kernel: Linux 6.18 LTS (sources.lock). Not for the Pixel: a phone needs its SoC, panel, touch, PMIC drivers.

# ---- base system
CONFIG_EXPERT=y                         # makes the "basic" options choosable (BLOCK, MULTIUSER, FUTEX, PRINTK...):
#                                         without it, allnoconfig silently leaves those at their defaults (on)
CONFIG_SMP=y                            # the VM runs 1-4 vCPUs (htest --smp, --matrix)
CONFIG_NR_CPUS=8
CONFIG_PRINTK=y                         # kernel messages on the serial console (boot problems, oopses)
CONFIG_BUG=y
CONFIG_KALLSYMS=y                       # symbol names in oops reports
CONFIG_BINFMT_ELF=y                     # the init (aarch64 static) and the test programs (32-bit static ELF)
CONFIG_MODULES=n                        # everything built in: one Image, no module loading
CONFIG_BLOCK=n                          # no disks: initramfs + 9p shares only
CONFIG_MULTIUSER=n                      # everything runs as root; no uid/gid syscalls needed

# ---- time
CONFIG_HIGH_RES_TIMERS=y                # the hosted kernel's 1 kHz tick thread and futex timeouts need ms accuracy
CONFIG_NO_HZ_IDLE=y                     # an idle phone does not wake the VM 250 times a second
CONFIG_POSIX_TIMERS=y                   # setitimer(ITIMER_PROF): the sampling profiler (htest --env PROFILE=1)
CONFIG_RTC_CLASS=y                      # the phone's date: the hosted variant reads CLOCK_REALTIME,
CONFIG_RTC_HCTOSYS=y                    #   set at boot from virt's PL031 RTC (without it: 1970)
CONFIG_RTC_DRV_PL031=y

# ---- what the hosted kernel uses from Linux (src/hosted/rt, nkern/linux, memmodel/linux)
CONFIG_FUTEX=y                          # the scheduler hand-over, events, semaphores, idle waits
CONFIG_SHMEM=y                          # memfd and tmpfs
CONFIG_MEMFD_CREATE=y                   # EXE data and the RAM drive as memory files
CONFIG_SECCOMP=y                        # exec calls that are not patched trap on the instruction pointer (SIGSYS)
CONFIG_SECCOMP_FILTER=y
CONFIG_CROSS_MEMORY_ATTACH=y            # process_vm_readv: IPC copies in the multi-process design (t_shared)

# ---- 32-bit ARM user code (the phone's ROM, ARMv5/v6, runs as AArch32 EL0)
CONFIG_COMPAT=y                         # 32-bit processes
CONFIG_COMPAT_32BIT_TIME=y              # nanosleep, clock_gettime, futex timeouts with 32-bit time_t: what the
#                                         hosted runtime calls (without it they fail: sleeps return at once)
CONFIG_ARMV8_DEPRECATED=y               # instructions ARMv8 deprecated, emulated by the kernel:
CONFIG_SWP_EMULATION=y                  #   SWP/SWPB (some ROM apps; /proc/sys/abi/swp = 1 set by init)
CONFIG_CP15_BARRIER_EMULATION=y         #   CP15 barrier MCRs (ARMv6 code)
CONFIG_SETEND_EMULATION=y               #   SETEND
CONFIG_COMPAT_ALIGNMENT_FIXUPS=y        # unaligned multi-word accesses ARMv5/v6 code makes
CONFIG_KUSER_HELPERS=n                  # no code here uses Linux's 32-bit helper page (0xffff0000): freestanding runtime
CONFIG_COMPAT_VDSO=n                    # no libc in the 32-bit programs: no vDSO
CONFIG_ARM64_4K_PAGES=y                 # Symbian's 4 KB pages map 1:1
CONFIG_ARM64_VA_BITS_48=y

# ---- file systems the init mounts (src/hosted/init/init.c)
CONFIG_BLK_DEV_INITRD=y                 # the initramfs (uncompressed cpio from htest: no decompressor needed)
CONFIG_PROC_FS=y                        # /proc (lxtop, cmdline)
CONFIG_PROC_SYSCTL=y                    # /proc/sys/abi/swp and cp15_barrier
CONFIG_PROC_PAGE_MONITOR=y              # /proc/PID/smaps_rollup: PSS in lxtop (the phone window's Linux view)
CONFIG_SYSFS=y                          # /sys: the ivshmem BAR's resource2 file
CONFIG_DEVTMPFS=y                       # /dev
CONFIG_TMPFS=y                          # /tmp

# ---- console
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y              # virt's UART: test output, the phone's serial log
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ---- PCI and virtio: the 9p shares and the phone window's shared memory
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y               # virt's ECAM PCIe host
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y                     # virtio-9p-pci (-virtfs)
CONFIG_NET=y                            # 9p's transport layer lives under NET (no network devices, no IP)
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y            # the menu 9P_FS sits in
CONFIG_9P_FS=y                          # /rom (ROM image), /seed (drive seeds), /out (results)
# ivshmem (htest --phone) needs no driver: the BAR is mapped through sysfs (PCI + SYSFS above)
