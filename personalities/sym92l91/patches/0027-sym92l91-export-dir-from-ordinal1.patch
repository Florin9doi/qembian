 		ExecLoaderCodeSegUserSize = ExecLoaderCodeSegSize;
 		ExecLoaderProcessTail = _FOFF(TProcessCreateInfo, iDebugAttributes) - sizeof(TCodeSegCreateInfo);	// 36
+		ExecExportDirFromOrdinal1 = 1;	// its loader: User::Alloc(iExportDirCount * 4), buf[ordinal - 1] [V N81 efile 0x801620c2]
 		}
 	else if (pers == KPersonalitySym91 || pers == KPersonalitySym91R)
 		{
